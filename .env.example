# ================================================
# ÇUKUR BURGER BOT — Environment Variables (Railway)
# cp .env.example .env  →  keyin to'ldiring
# ================================================

# --- Telegram ---
# Bot tokeni (@BotFather dan oling)
BOT_TOKEN=your_bot_token_here

# Webhook URL — Railway deploy qilingandan keyingi public domen.
# Format: https://your-app.up.railway.app  (oxirida / belgisi BO'LMASIN)
WEBHOOK_URL=https://your-app.up.railway.app

# Port — Railway avtomatik beradi (odatda tegmaysiz)
PORT=3000

# --- Supabase ---
# Supabase loyiha URL (Settings > API > Project URL)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# ⚠️ MUHIM: Bu SECRET / service_role kalit bo'lishi SHART (sb_secret_... yoki
# legacy "service_role" JWT). Bot site_settings / orders / menu_items ga YOZADI,
# RLS esa faqat service_role ga yozishga ruxsat beradi.
# ❌ Bu yerga publishable/anon kalit (sb_publishable_...) QO'YMANG —
#    aks holda to'lov sozlamalarini saqlashda "RLS" xatosi chiqadi.
# Olish: Supabase > Settings > API > "service_role" (yashirin) kalitini nusxalang.
SUPABASE_SERVICE_KEY=sb_secret_your_service_role_key_here

# --- Owner ---
# Bot egasining Telegram ID raqami (@userinfobot dan oling)
OWNER_ID=1869515752

# --- Web Push (ixtiyoriy, sayt buyurtma holati push xabarlari uchun) ---
# Kalit juftligini generatsiya qilish:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY ni saytning VITE_VAPID_PUBLIC_KEY iga ham qo'ying (bir xil public kalit).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@cukurburger.uz
